# Environment variables read by the Netlify functions, the on-demand Astro
# routes and the scripts in this repo.
#
# Production values live in the Netlify UI (Site configuration > Environment
# variables). For local runs, copy this file to .env.local and fill in what you
# need: scripts/bluesky-link.mjs and scripts/standard-site-publish.mjs read
# .env.local, and `netlify dev` injects the Netlify values. Never commit real
# values.

# --- Spam protection (ALTCHA) ---
# HMAC key for altcha-challenge, newsletter-subscribe and /api/ama/submit. Any long random string.
ALTCHA_HMAC_KEY=replace-with-a-long-random-string

# --- Newsletter (Listmonk) ---
# Listmonk API user for newsletter-subscribe, newsletter-stats and retroactive-tag-subscribers.sh.
LISTMONK_API_USER=netlify-builds
# Listmonk API key/password for that user.
LISTMONK_API_KEY=replace-with-listmonk-api-key
# Optional. Listmonk API base URL; defaults to https://n.a11y.nl/api.
LISTMONK_BASE_URL=https://n.a11y.nl/api
# Optional. Sent as X-Bypass-Token to get past Cloudflare in front of Listmonk.
CF_BYPASS_TOKEN=replace-with-cloudflare-bypass-token

# --- AMA (/ama) ---
# HMAC secret that signs AMA question ids and moderation links.
AMA_SIGNING_SECRET=replace-with-a-long-random-string
# Telegram bot token used to send new AMA questions for moderation.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# Telegram chat id that receives AMA moderation messages.
TELEGRAM_CHAT_ID=123456789
# Secret token Telegram sends with webhook calls to /api/ama/telegram-callback.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Bluesky / AT Protocol scripts ---
# Handle used by the bluesky:link script.
BLUESKY_HANDLE=your-handle.bsky.social
# Dedicated app password for bluesky:link and standard-site:setup/publish (https://bsky.app/settings/app-passwords).
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# One-off app password for scripts/events-migration; revoke after use.
GUIDO_ATPROTO_APPPASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Build flags ---
# Set to "true" to allow search engine indexing; otherwise pages get a noindex meta tag.
PUBLIC_ALLOW_INDEXING=true
# Set to "true" to run external content validation during the build (always on when ASTRO_MODE=production).
VALIDATE_CONTENT=false
