{
  "name": "gui-do",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "build": "node scripts/standard-site-publish.mjs && astro build && node scripts/test-robots.js",
    "preview": "astro build --mode preview",
    "production": "astro build --mode production",
    "astro": "astro",
    "audit:apca": "node scripts/apca-audit.mjs",
    "check-dark-mode": "node scripts/check-dark-mode.js",
    "fix-dark-mode": "node scripts/fix-dark-mode.js",
    "fix-dark-mode:dry": "node scripts/fix-dark-mode.js --dry-run",
    "test": "vitest --max-workers=2",
    "test:urls": "RUN_URL_TESTS=1 vitest run src/data/__tests__/validateUrls.test.ts",
    "test:a11y": "playwright test",
    "test:a11y:inventory": "A11Y_INVENTORY=1 playwright test",
    "test:robots": "node scripts/test-robots.js",
    "validate-content": "node scripts/validate-content.js",
    "bluesky:link": "node scripts/bluesky-link.mjs",
    "standard-site:setup": "node scripts/standard-site-setup.mjs",
    "standard-site:publish": "node scripts/standard-site-publish.mjs",
    "check:trailing-slashes": "node scripts/check-trailing-slashes.js",
    "optimize-images": "node scripts/optimize-images.mjs",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,jsx,mjs,css,md,mdx}\"",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,mjs,css,md,mdx}\"",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "typecheck": "astro check",
    "events:snapshot": "node scripts/snapshot-events.mjs"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@atproto/api": "^0.28.1",
    "@iconify-json/tabler": "^1.2.42",
    "@netlify/blobs": "^11.1.4",
    "@resvg/resvg-js": "^2.6.2",
    "@singi-labs/sifa-sdk": "^0.19.110",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "altcha-lib": "^2.6.0",
    "astro": "^7.4.1",
    "astro-icon": "^1.2.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.9.3",
    "node-html-parser": "^9.0.5",
    "react": "^19.3.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "~4.11.3",
    "@playwright/test": "~1.61.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "node-html-markdown": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.12",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "lodash": "^4.17.23",
    "@isaacs/brace-expansion": "^5.0.1",
    "tar": "^7.5.9",
    "devalue": "^5.6.3",
    "ajv": "^8.18.0"
  }
}
