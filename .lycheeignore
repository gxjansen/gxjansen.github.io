# LinkedIn returns 999 for automated requests (includes country subdomains)
https?://([a-z]{2,3}\.)?linkedin\.com/.*

# Twitter/X rate-limits aggressively
https?://(www\.)?twitter\.com/.*
https?://(www\.)?x\.com/.*

# Localhost and dev URLs
https?://localhost.*
https?://127\.0\.0\.1.*

# Medium blocks automated requests
https?://(www\.)?medium\.com/.*

# Forbes blocks automated requests
https?://(www\.)?forbes\.com/.*

# Reddit blocks automated requests
https?://(www\.)?reddit\.com/.*

# Other sites that block bots
https?://(www\.)?raspberrypi\.com/.*
https?://help\.openai\.com/.*
https?://(www\.)?encora\.com/.*
https?://nomadmage\.com/.*
https?://devrims\.com/.*
https?://saufter\.io/.*

# YouTube thumbnails (maxresdefault.jpg often missing for older videos)
https?://i\.ytimg\.com/.*

# Dead domains (historical references in old blog posts)
https?://(www\.)?community\.magento\.com/.*
https?://(www\.)?magentocommerce\.com/.*
https?://(www\.)?artio\.net/.*
https?://(www\.)?betterhumans\.coach\.me/.*
https?://(www\.)?webinsight\.be/.*
https?://(www\.)?objeqt\.com/.*

# Netlify serverless functions (not static files)
\.netlify/functions/

# AT Protocol URIs (at://did:plc:...) are not fetchable over HTTP
^at://

# Anchor-only links
^#

# On-demand (SSR) routes: not present in dist/, so lychee reports file:// misses.
# Source of truth: grep -rl "prerender = false" src/pages
file://.*/dist/(now|bookshelf)/?$
file://.*/dist/(api|internal)/.*
file://.*/dist/ama/q/.*

# /privacy-policy is a Netlify 301 to /privacy (dist/_redirects); lychee cannot follow redirects on disk
file://.*/dist/privacy-policy/?$
# /categories is a Netlify redirect to /post/ (astro.config.mjs), so dist has no page for it.
file://.*/dist/categories/?$
# The 404 page's canonical/og:url is /404/, but the build writes 404.html.
file://.*/dist/404/?$

# Bot-blocking or rate-limiting sites: they answer a browser with 200 but reject lychee
# (curl with a browser UA confirmed spryker.com and fastercapital.com return 200).
https?://(www\.)?spryker\.com/.*
https?://(www\.)?fastercapital\.com/.*
https?://docs\.paperless-ngx\.com/.*
https?://fast\.wistia\.com/.*
https?://(www\.)?npmjs\.com/.*
https?://(www\.)?academia\.edu/.*
https?://(www\.)?udemy\.com/.*
https?://(www\.)?futurelearn\.com/.*
https?://(www\.)?supernote\.com/.*
https?://shop\.pimoroni\.com/.*
https?://(www\.)?firewalla\.com/.*
https?://(www\.)?datacamp\.com/.*

# Placeholder URLs used as examples in posts
https://github\.com/YOUR_ORG/YOUR_REPO.*
https://github\.com/actions/runner/releases/download/vX\.Y\.Z/.*

# bsky.social XRPC endpoints quoted in posts need query parameters; a bare request returns 400
https://bsky\.social/xrpc/.*
# cxl.com (formerly conversionxl.com) returns 403 to non-browser clients; pages load fine in a browser.
https?://(www\.)?cxl\.com/.*
