---
// main layout
import BaseLayout from "@layouts/BaseLayout.astro";

// components
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// images for communities (logo + wordmark variants)
import joomlaLogo from "@images/events/joomla-wordmark.svg";
import magentoLogo from "@images/events/magento-wordmark.svg";
import crocafeLogo from "@images/events/crocafe-wordmark.png";
import sprykerLogo from "@images/events/spryker-wordmark.svg";
import atmosphereLogo from "@images/events/atmosphere-heart.svg";

// Community URLs for JSON-LD
const communityUrls: Record<string, string> = {
  "Mambo/Joomla!": "https://www.joomla.org/",
  "Dutchento / Meet Magento Netherlands": "https://www.dutchento.org/",
  "CRO.CAFE": "https://cro.cafe/",
  Spryker: "https://spryker.com/",
  "Atmosphere / AtmosphereConf": "https://atmosphere.community/",
};

// Community data
const communities = [
  {
    name: "Atmosphere / AtmosphereConf",
    period: "2026-present",
    role: "Co-organizer AtmosphereConf 2027, for the Atmosphere Community Cooperative",
    roleType: "professional",
    context: "AT Protocol community",
    logo: atmosphereLogo,
    description:
      'I\'m hired by the Atmosphere Community Cooperative, a co-op for AT Protocol work that fits neither Bluesky (the company) nor the IETF (the standard). The co-op runs <a href="https://atmosphereconf.org/" target="_blank" rel="noopener noreferrer">AtmosphereConf</a> each year, pays community members to speak about atproto at industry events, and funds developers maintaining core infrastructure, all governed through sociocratic circles and consent decisions. I co-organize AtmosphereConf 2027 in the Netherlands (April 29 - May 2), focusing on European sponsors, the CfP and program, and an attendee city guide. It builds on my 11 editions as main organizer of Meet Magento Netherlands, now applied to an open protocol community.',
    achievements: [
      "Co-organizing AtmosphereConf 2027 in the Netherlands, April 29 - May 2",
      "Growing the European sponsor base beyond today's mostly US list",
      'Building <a href="https://sifa.id/" target="_blank" rel="noopener noreferrer">Sifa ID</a> (LinkedIn but on AT Protocol) via my company <a href="https://singi.dev/" target="_blank" rel="noopener noreferrer">Singi Labs</a>, and the <a href="https://atproto.eu/" target="_blank" rel="noopener noreferrer">atproto.eu</a> community sites for AT Protocol people in Europe (NL, BE, NO, HU, PL), separate from the co-op',
      "Attended AtmosphereConf 2026 in Vancouver, ran an unconference session on Sifa",
    ],
  },
  {
    name: "Spryker",
    period: "2021-2025",
    role: "Employee (Senior Director, Global Business & Technology Evangelist)",
    roleType: "professional",
    context: "4+ years",
    logo: sprykerLogo,
    description:
      "Built the enterprise community function from scratch, serving 130+ B2B clients and their developer ecosystem. This was community building in a different context: enterprise software with no freemium tier, where community size is tied to sales rather than organic growth. Required different strategies: Customer Advisory Boards, MIT-licensed module ecosystems, and structures that translate community intelligence into product decisions.",
    achievements: [
      "Built community platform serving 130+ enterprise accounts with 3-person team",
      "Launched Customer Advisory Board connecting enterprise clients directly to product teams",
      "Established MIT-licensed module ecosystem, creating a vendor-independent innovation layer",
      "Community-driven initiatives now influence 25% of product roadmap decisions",
      "Multiple hackathon projects adopted into core product",
    ],
    quotes: [
      {
        text: "Guido built the community function from the ground up, crafting not just a team, but a true movement.",
        name: "Elise Mueller-Bischoff",
        context: "EVP People & Culture, Spryker",
      },
      {
        text: "With a small, high-performing team, Guido created a developer and customer community from scratch and turned it into a real asset for the business.",
        name: "Eric Schreiner",
        context: "Chief Customer Officer, Spryker (my manager)",
      },
    ],
  },
  {
    name: "CRO.CAFE",
    period: "2018-2022",
    role: "Creator & Host",
    roleType: "professional",
    context: "4 years",
    logo: crocafeLogo,
    description:
      "I noticed the conversion optimization community lacked a consistent interview-format podcast where practitioners shared how they actually worked. I created CRO.CAFE as a side project where I had 1-on-1 conversations with people from agencies, brands, and tool vendors about their real work. The show attracted sponsorship and spun off into Dutch, Spanish, and German versions hosted by other specialists.",
    achievements: [
      "Produced 200+ episodes",
      "Received Experimentation Culture Award for community impact",
      "Expanded to four languages with other hosts",
      "Built sustainable sponsorship model",
      "Created multi-language network reaching global CRO community",
    ],
    quotes: [
      {
        text: "He is a great podcast host who asks the right questions and is capable of creating an atmosphere/learning environment which entices you to learn more about CRO.",
        name: "Daniël van de Poppe",
        context: "Podcaster, Spraakmaker Media (CRO.CAFE partner)",
      },
    ],
  },
  {
    name: "Dutchento / Meet Magento Netherlands",
    period: "2008-2021",
    role: "Founder, Association Board Member",
    roleType: "volunteer",
    context: "13 years",
    logo: magentoLogo,
    description:
      "I founded the Dutch community for the Magento e-commerce platform when there was no local hub for developers and merchants. What started as local meetups grew into Meet Magento Netherlands: an annual event scaling to 600+ attendees that sparked a global event series in other countries.",
    achievements: [
      "Scaled from local meetups to 600+ annual attendees",
      "Organized 11 editions of Meet Magento Netherlands",
      "Received Community Builder Award from eBay CEO John Donahoe",
      "Co-created a model replicated by Meet Magento events worldwide",
      "Founding Board Member of the global Magento Association",
    ],
    quotes: [
      {
        text: 'Guido is one of the best "connectors" I know. He headed an amazing Magento community day in Holland which I was a part of in January 2009.',
        name: "Yoav Kutner",
        context: "Co-founder, Magento",
      },
      {
        text: "Guido has a big heart for the community and is always very innovative when it comes to taking the community to bigger heights.",
        name: "Roy de Vries",
        context: "Dutchento team member",
      },
    ],
  },
  {
    name: "Mambo/Joomla!",
    period: "2004-2009",
    role: "Translator, local community organizer (virtual and in-person)",
    roleType: "volunteer",
    context: "Open source CMS community",
    logo: joomlaLogo,
    description:
      "My first community experience. I contributed to the Mambo open source CMS project with (Dutch) translations, then followed the community fork that became Joomla! in 2005. This was my introduction to how open source communities work: the governance challenges, the passion, and how open source communities can build software that competes with commercial products.",
    achievements: [
      "Early contributor to what became one of the world's most popular CMS platforms",
      "Learned open source community dynamics firsthand",
      "Ran the local Dutch community portal, organized meetups and the yearly Joomladays conference.",
    ],
    quotes: [
      {
        text: "He knew what the wishes of the community were and managed to turn those to features on the forum or website.",
        name: "Robbie van Riet",
        context: "Joomla community member",
      },
      {
        text: "Guido managed to get the nicest team ever for the joomladays, I'm glad I was one of them.",
        name: "Meta Kruijs",
        context: "Joomladays team member",
      },
    ],
  },
];
---

<BaseLayout
  title="Community Building | Guido X Jansen"
  description="Track record of building developer and technical communities from zero: Joomla!, Dutchento/Meet Magento, CRO.CAFE, Spryker, and the Atmosphere (AT Protocol) community. Community Builder Award recipient."
  type="communities"
  communities={communities.map((c) => ({
    name: c.name,
    url: communityUrls[c.name],
  }))}
>
  <div class="home communities-page">
    <!-- Hero -->
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div class="page-hero">
        <span class="hand-note">where I've built</span>
        <h1
          class="font-display mt-1 mb-4 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
        >
          Building communities from zero
        </h1>
        <p class="text-base-600 dark:text-base-400 text-lg leading-relaxed">
          I've built community functions from scratch multiple times, across
          very different contexts.
        </p>
      </div>
    </section>

    <!-- Communities -->
    <section class="relative z-10 pb-[clamp(3rem,7vw,5.5rem)]">
      <div class="flex flex-col gap-[clamp(3rem,7vw,5rem)]">
        {communities.map((community, index) => <div
          class="grid items-start gap-8 md:grid-cols-2 md:gap-12"
        >
          <div class={index % 2 === 1 ? "md:order-2" : ""}>
            <div
              class="border-base-200 dark:border-base-800 flex aspect-video items-center sm:min-h-[200px] justify-center rounded-2xl border bg-white p-6 sm:p-8"
            >
              <Image
                src={community.logo}
                alt={`${community.name} logo`}
                class="h-auto w-[74%] max-w-[420px] object-contain"
              />
            </div>
          </div>

          <div class={index % 2 === 1 ? "md:order-1" : ""}>
            <div class="flex flex-wrap items-center gap-3">
              <span class="chip chip--plain">{community.period}</span>
              <span class="text-base-500 text-sm">{community.context}</span>
            </div>

            <h2
              class="font-display mt-3 text-[clamp(1.6rem,3vw,2.1rem)] font-extrabold tracking-[-0.02em]"
            >
              {community.name}
            </h2>
            <p
              class="text-primary-600 dark:text-primary-400 mt-1 font-semibold"
            >
              {community.role}
            </p>

            <p
              class="text-base-600 dark:text-base-400 mt-3 leading-relaxed"
              set:html={community.description}
            />

            <div class="mt-5">
              <h3
                class="text-base-500 mb-3 text-xs font-bold tracking-[0.08em] uppercase"
              >
                Key achievements
              </h3>
              <ul class="flex flex-col gap-2">
                {community.achievements.map((achievement) => <li
                  class="text-base-600 dark:text-base-400 flex items-start gap-2.5"
                >
                  <Icon
                    name="tabler/outline/check"
                    class="text-primary-600 dark:text-primary-400 mt-0.5 size-5 shrink-0"
                    aria-hidden="true"
                  />
                  {/* Achievements are trusted strings from this file; some carry links. */}
                  <span set:html={achievement} />
                </li>)}
              </ul>
            </div>

            {community.quotes && <div class="mt-6">
              <h3
                class="text-base-500 mb-3 text-xs font-bold tracking-[0.08em] uppercase"
              >
                Recommendations
              </h3>
              <div class="flex flex-col gap-4">
                {community.quotes.map((quote) => <figure
                  class="border-primary-600/30 dark:border-primary-400/30 border-l-4 pl-4"
                >
                  <blockquote
                    class="text-base-700 dark:text-base-300 leading-relaxed italic"
                  >
                    &ldquo;{quote.text}&rdquo;
                  </blockquote>
                  <figcaption class="text-base-500 mt-1.5 text-sm">
                    <span class="text-base-700 dark:text-base-300 font-semibold"
                      >{quote.name}</span
                    >, {quote.context}
                  </figcaption>
                </figure>)}
              </div>
            </div>}
          </div>
        </div>)}
      </div>
    </section>
  </div>
</BaseLayout>
