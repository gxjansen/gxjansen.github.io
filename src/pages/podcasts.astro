---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImage, Image } from "astro:assets";
import croCafeArt from "@assets/images/podcasts/cro-cafe.webp";
import sheeptankArt from "@assets/images/podcasts/sheeptank.webp";
import { Icon } from "astro-icon/components";
import { getPodcastEpisodes } from "../lib/podcastFeeds";
import { formatShortDateUTC } from "../utils/dates";

// Build-time fetch: episodes are baked into the static HTML so crawlers and
// no-JS browsers see the full list. Never throws — falls back to [] on failure.
const episodes = await getPodcastEpisodes();

// Download and shrink each episode's artwork at build time (feeds ship
// 1400-3000px images), so visitors load small local WebP files instead of
// hotlinking the feed hosts. An image that fails just renders without art.
const THUMB = 256;
const thumbs = await Promise.all(
  episodes.map(async (episode) => {
    if (!episode.imageUrl) return undefined;
    try {
      const image = await getImage({
        src: episode.imageUrl,
        width: THUMB,
        height: THUMB,
        fit: "cover",
        format: "webp",
      });
      return image.src;
    } catch (error) {
      console.error(
        `[podcasts] Could not optimize artwork ${episode.imageUrl}:`,
        error instanceof Error ? error.message : error,
      );
      return undefined;
    }
  }),
);

const podcasts = [
  {
    icon: "sheep",
    image: sheeptankArt,
    title: "Sheeptank",
    text: "A lighthearted, fast-paced format: one interesting business case (pitched by the sheep) and a final verdict (from the wolves).",
    href: "https://media.spryker.com/podcasts/187220417647/rss.xml",
  },
  {
    icon: "tabler/outline/a-b",
    image: croCafeArt,
    title: "CRO.CAFE",
    text: "Conversion rate optimization and business experimentation, with episodes in English, Dutch, Spanish and German.",
    href: "https://www.cro.cafe",
  },
  {
    icon: "tabler/outline/friends",
    title: "Spryker Community",
    text: "Stories from the community, sharing insights and best practices.",
    href: "https://www.youtube.com/results?search_query=spryker",
  },
];
---

<BaseLayout
  title="Guido's Podcasts"
  description="The podcasts Guido X Jansen hosts and produces: Sheeptank, CRO.CAFE and more. Over 250 episodes on community, experimentation and business."
>
  <div class="home home--wide podcasts-page">
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div class="max-w-[60ch]">
        <span class="hand-note">on the mic</span>
        <h1
          class="font-display mt-1 mb-4 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
        >
          Podcasts I host &amp; produce
        </h1>
        <p class="text-base-600 dark:text-base-400 text-lg leading-relaxed">
          Podcasting is a great way to learn, share, and get to know people.
          I've published over 250 episodes across a few different shows.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {podcasts.map((p) => <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-base-50 dark:bg-base-900 border-base-200 dark:border-base-800 reveal flex flex-col rounded-2xl border p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          {p.image ? (
            <Image
              src={p.image}
              alt=""
              width={160}
              height={160}
              class="border-base-200 dark:border-base-800 mb-4 size-20 rounded-xl border object-cover"
            />
          ) : (
            <div
              class="bg-primary-600/10 text-primary-600 dark:bg-primary-400/10 dark:text-primary-400 mb-4 flex size-20 items-center justify-center rounded-xl"
            >
              <Icon name={p.icon} class="size-9" aria-hidden="true" />
            </div>
          )}
          <h2
            class="font-display group-hover:text-primary-600 dark:group-hover:text-primary-400 text-[1.2rem] font-extrabold transition"
          >
            {p.title}
          </h2>
          <p
            class="text-base-600 dark:text-base-400 mt-2 text-[0.95rem] leading-relaxed"
          >
            {p.text}
          </p>
          <span
            class="text-primary-600 dark:text-primary-400 font-display mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-bold"
          >
            Listen <span aria-hidden="true">→</span>
          </span>
        </a>)}
      </div>
    </section>

    <section class="relative z-10 pb-[clamp(3rem,7vw,5.5rem)]">
      <div class="sec-head">
        <div>
          <span class="hand-note">fresh from the feed</span>
          <h2>Recent episodes</h2>
        </div>
      </div>

      <div id="podcast-feed-container">
        {episodes.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {episodes.map((episode, i) => <article
              class="bg-base-100 dark:bg-base-900 border-base-200 dark:border-base-800 flex flex-col gap-3 rounded-2xl border p-5"
            >
              <div class="flex items-start gap-4">
                {thumbs[i] && (
                  <img
                    src={thumbs[i]}
                    alt=""
                    width={THUMB}
                    height={THUMB}
                    loading="lazy"
                    decoding="async"
                    class="border-base-200 dark:border-base-800 size-[4.5rem] shrink-0 rounded-xl border object-cover"
                  />
                )}
                <div class="min-w-0">
                  <p class="text-base-600 dark:text-base-400 text-sm">
                    {episode.podcastName}
                    {episode.pubDate && (
                      <>
                        {" · "}
                        <time
                          datetime={new Date(episode.pubDate).toISOString()}
                        >
                          {formatShortDateUTC(episode.pubDate)}
                        </time>
                      </>
                    )}
                  </p>
                  <h3
                    class="font-display text-[1.05rem] leading-snug font-extrabold"
                  >
                    {episode.link ? (
                      <a
                        href={episode.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary-600 dark:hover:text-primary-400 transition"
                      >
                        {episode.title}
                      </a>
                    ) : (
                      episode.title
                    )}
                  </h3>
                </div>
              </div>
              <audio
                class="mt-auto w-full"
                controls
                preload="none"
                src={episode.audioUrl}
                aria-label={`Play ${episode.title}`}
              />
            </article>)}
          </div>
        ) : (
          <div class="bg-base-100 dark:bg-base-900 rounded-2xl p-8 text-center">
            <p class="text-base-700 dark:text-base-300">
              Episodes aren't loading right now. You can visit the podcasts
              directly:
            </p>
            <div class="mt-4 space-y-2">
              <a
                href="https://media.spryker.com/podcasts/187220417647/rss.xml"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-600 dark:text-primary-400 block font-semibold hover:underline"
              >
                Sheeptank
              </a>
              <a
                href="https://www.cro.cafe"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-600 dark:text-primary-400 block font-semibold hover:underline"
              >
                CRO.CAFE
              </a>
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="relative z-10 pb-[clamp(3rem,7vw,5.5rem)]">
      <div
        class="bg-base-50 dark:bg-base-900 border-base-200 dark:border-base-800 flex flex-col gap-5 rounded-3xl border p-6 sm:flex-row sm:items-center sm:justify-between sm:p-9"
      >
        <div>
          <span class="hand-note">your turn</span>
          <h2
            class="font-display mt-1 text-2xl font-extrabold tracking-[-0.02em] sm:text-3xl"
          >
            Want to come on a show?
          </h2>
          <p
            class="text-base-600 dark:text-base-400 mt-2 max-w-xl leading-relaxed"
          >
            Got a business case for Sheeptank, an experimentation story for
            CRO.CAFE, or an idea for a collaboration? Tell me about it.
          </p>
        </div>
        <a
          href="/contact/"
          class="bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-400 font-display inline-flex shrink-0 items-center gap-1.5 rounded-full px-6 py-3 font-bold text-white transition"
        >
          Get in touch <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
