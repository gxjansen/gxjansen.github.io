---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

// Shared sections (already on the redesign system)
import AwardsSection from "@components/Press/AwardsSection.astro";
import ColleagueTestimonials from "@components/Testimonials/ColleagueTestimonials.astro";
import FeatureGalleryMarquee from "@components/Feature/FeatureGalleryMarquee.astro";

import { loadHonors } from "../lib/honors";
import { yearsBuilding, countryCount, talksCount } from "@data/siteStats";

// Work awards and nominations from Sifa (src/lib/honors.ts), newest first.
const awards = (await loadHonors()).filter((h) => h.area === "work");

// Biography, told as a short timeline instead of stock photos.
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const story = [
  {
    // Stable anchor: /awards links to /about/#athletic-years.
    id: "athletic-years",
    icon: "tabler/outline/swimming",
    title: "The athletic years",
    paras: [
      "I was born in 1982 in Zwolle, in the Netherlands. I lived in Hattem, Tiel, Amersfoort, Utrecht, Breukelen (yes, Brooklyn), Hoofddorp, Amsterdam and now Ouderkerk aan de Amstel (a suburb of Amsterdam).",
      "Until 2004, I spent most of my time swimming: training for national and European championships. That chapter taught me discipline, competition, and the value of showing up consistently.",
    ],
  },
  {
    icon: "tabler/outline/school",
    title: "University & psychology",
    paras: [
      "I studied Applied Cognitive Psychology at the University of Utrecht. I was board member of the Student Group of Social Sciences (SGS) in 2006/2007.",
      "This foundation in psychology became the lens through which I understand community dynamics, user behavior, and what actually motivates people to participate and contribute.",
    ],
    cta: {
      label: "View my LinkedIn profile",
      href: "https://www.linkedin.com/in/gxjansen/",
    },
  },
  {
    icon: "tabler/outline/route",
    title: "Career journey",
    paras: [
      "My career has bridged psychology and technology: from running 500+ experiments at companies like Randstad and JDE, to building community functions at major platforms.",
      "Each role reinforced the same insight: you can't reliably predict why people behave the way they do, so you build systems that test assumptions instead of trusting them. Whether optimizing conversions or growing developer ecosystems, the principle stays the same.",
    ],
    cta: {
      label: "Credentials, awards & articles",
      href: "/authors/gxjansen/",
    },
  },
];

const eyebrow = "eyebrow";
const card =
  "bg-base-50 dark:bg-base-900 border-base-200 dark:border-base-800 rounded-2xl border p-5";
---

<BaseLayout
  title="About Guido | Community Builder"
  description={`Guido X Jansen: community builder with ${yearsBuilding}+ years creating technical ecosystems. Founded Dutchento/Meet Magento, created CRO.CAFE, led Spryker's enterprise community. Cognitive psychologist turned DevRel leader. ${talksCount} talks across ${countryCount} countries.`}
>
  <div class="home about-page">
    <!-- ============ HERO ============ -->
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div
        class="grid grid-cols-1 items-center gap-[clamp(1.5rem,4vw,3rem)] md:grid-cols-[1.2fr_0.8fr]"
      >
        <div>
          <span class={eyebrow}>About</span>
          <h1
            class="font-display mt-2 mb-5 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
          >
            Hi, I'm Guido <span class="inline-block">👋</span>
          </h1>
          <div
            class="text-base-700 dark:text-base-300 max-w-[56ch] space-y-4 text-[1.08rem] leading-relaxed"
          >
            <p>
              I build communities that matter to the business, and to the people
              in them.
            </p>
            <p>
              Where many optimize for engagement metrics, I turn what developers
              and customers tell us into product strategy. That tends to lower
              support costs and build the kind of trust that keeps people
              around, without locking them in.
            </p>
            <p>
              I've done this from zero
              <a
                href="/communities/"
                class="text-primary-600 dark:text-primary-400 font-semibold"
                >multiple times</a
              >. My psychology background taught me you can't reliably predict
              how technical users will behave, so I design community work as
              small experiments and pay attention to what they actually do.
            </p>
          </div>
        </div>
        <div class="portrait reveal mx-auto w-full max-w-[320px]">
          <img
            src="/images/redesign/guido-portrait.webp"
            alt="Guido X Jansen, community strategist and cognitive psychologist"
            width="480"
            height="600"
            loading="eager"
          />
          <span class="tag">that's me</span>
        </div>
      </div>
    </section>

    <!-- ============ THE STORY ============ -->
    <section class="relative z-10 py-[clamp(3rem,7vw,5.5rem)]">
      <div class="page-hero">
        <span class="hand-note">the backstory</span>
        <h2>How I got here</h2>
        <p
          class="text-base-600 dark:text-base-400 mt-4 text-[1.05rem] leading-[1.6]"
        >
          Before community strategy, there was competitive swimming. I spent my
          early years training for national and European championships: learning
          discipline, competition, and the value of showing up consistently.
          That chapter ended in 2004, and a new one began.
        </p>
        <div class={`${card} mt-6 flex items-start gap-3`}>
          <Icon
            name="tabler/outline/letter-x"
            class="text-primary-600 dark:text-primary-400 mt-0.5 size-5 shrink-0"
            aria-hidden="true"
          />
          <p
            class="text-base-700 dark:text-base-300 text-[0.95rem] leading-relaxed"
          >
            To answer a common question right out of the gate: yes, the X in my
            name isn't just there for decorative reasons. My second name is
            Xavier!
          </p>
        </div>
      </div>

      <ol class="mt-10 flex flex-col">
        {story.map((s) => <li
          id={"id" in s && s.id ? s.id : slug(s.title)}
          class="border-base-200 dark:border-base-800 relative scroll-mt-24 border-l-2 pb-8 pl-8 last:pb-0"
        >
          <span
            class="bg-primary-600 dark:bg-primary-400 absolute top-0 -left-[15px] flex size-7 items-center justify-center rounded-full ring-4 ring-[var(--color-background)] dark:ring-[var(--color-background-dark)]"
          >
            <Icon name={s.icon} class="size-4 text-white" aria-hidden="true" />
          </span>
          <h3 class="font-display text-[1.2rem] font-extrabold">
            {s.title}
          </h3>
          <div
            class="text-base-600 dark:text-base-400 mt-2 max-w-[60ch] space-y-2 text-[0.98rem] leading-relaxed"
          >
            {s.paras.map((p) => <p>{p}</p>)}
          </div>
          {s.cta && <a
            href={s.cta.href}
            {...(s.cta.href.startsWith("http")
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class="text-primary-600 dark:text-primary-400 font-display mt-3 inline-flex items-center gap-1.5 text-sm font-bold"
          >
            {s.cta.label} <span aria-hidden="true">→</span>
          </a>}
        </li>)}
      </ol>
    </section>

    <!-- ============ AWARDS ============ -->
    {awards.length > 0 && <AwardsSection awards={awards} />}

    <!-- ============ ENDORSEMENTS ============ -->
    <ColleagueTestimonials />

    <!-- ============ GALLERY ============ -->
    <section
      class="relative z-10 py-[clamp(3rem,7vw,5.5rem)]"
      aria-label="Photo gallery"
    >
      <FeatureGalleryMarquee />
    </section>
  </div>
</BaseLayout>
