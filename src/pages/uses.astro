---
// /uses: the hardware, software and services Guido uses, why, and what he
// dropped along the way. Static; the data lives in src/data/uses.ts.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  categoryOrder,
  currentItems,
  droppedItems,
  lastReviewed,
  principles,
  replacedBy,
  type UsesItem,
} from "@data/uses";

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

/** "2026-10" -> "October 2026", "2026" -> "2026". */
const partialDate = (value: string) => {
  const [year, month] = value.split("-");
  return month ? `${MONTHS[Number(month) - 1]} ${year}` : year;
};

/** "2026-11-01" -> "1 November 2026". */
const fullDate = (value: string) => {
  const [year, month, day] = value.split("-");
  return `${Number(day)} ${MONTHS[Number(month) - 1]} ${year}`;
};

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const itemId = (item: UsesItem) => `use-${slugify(item.name)}`;

// Bare domains in the texts ("atproto.nl") become links. The split keeps the
// matches at odd indexes. This site's own domain stays plain text.
const DOMAIN =
  /\b((?:[a-z0-9-]+\.)+(?:nl|eu|io|co|com|org|net|app|dev|cafe|do))\b/i;
const SELF = "gui.do";
// The item's link shows as its domain under the text, not on the name.
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const linkDomains = (text: string) =>
  text.split(new RegExp(DOMAIN.source, "gi")).map((part, i) => ({
    part,
    href: i % 2 && part !== SELF ? `https://${part}` : undefined,
  }));
// Markdown-style links ("[Fairbuds XL](https://...)") keep their label; the
// text around them still gets bare-domain linking.
const MD_LINK = /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g;
const linkify = (text: string) => {
  const out: { part: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(MD_LINK)) {
    out.push(...linkDomains(text.slice(last, m.index)));
    out.push({ part: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  out.push(...linkDomains(text.slice(last)));
  return out;
};

// Item photos live in src/assets/images/uses/; the data holds the file name.
// A name without a file fails the build instead of rendering a broken image.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/uses/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photo = (item: UsesItem) => {
  if (!item.photo) return undefined;
  const file = photoFiles[`../assets/images/uses/${item.photo}`];
  if (!file) throw new Error(`uses: no photo file "${item.photo}"`);
  return file.default;
};

// Story links point at posts on this site; show the post title as link text
// and link relatively so previews stay on their own host.
const posts = await getCollection("post");
const postTitles = new Map(posts.map((p) => [p.id, p.data.title]));
const story = (url: string | undefined) => {
  if (!url) return undefined;
  const match = url.match(/\/post\/([^/]+)\/?$/);
  if (!match) return { href: url, title: "the story behind it" };
  const id = match[1];
  return { href: `/post/${id}/`, title: postTitles.get(id) ?? id };
};

const groups = categoryOrder
  .map((name) => ({
    name,
    id: slugify(name),
    items: currentItems.filter((i) => i.category === name),
  }))
  .filter((g) => g.items.length > 0);

const dropped = droppedItems.map((item) => ({
  item,
  by: replacedBy(item),
}));
---

<BaseLayout
  title="Uses"
  description="The hardware, software and services Guido X Jansen uses, why he picked them, what they cost him, and what he dropped along the way."
>
  <section class="mt-24 w-full px-4">
    <div class="mx-auto max-w-3xl">
      <header class="mb-8">
        <p
          class="text-gold-light dark:text-gold font-hand -rotate-2 text-[1.5rem] leading-none"
        >
          what I actually use
        </p>
        <h1 class="h1 mt-2">Uses</h1>
        <p class="text-base-500 dark:text-base-400 mt-2 text-[.85rem]">
          Last reviewed
          <time datetime={lastReviewed}>{fullDate(lastReviewed)}</time>
        </p>
      </header>

      <div
        class="text-base-700 dark:text-base-300 max-w-2xl space-y-4 text-lg leading-relaxed"
      >
        <p>
          This is the hardware, software and services I use every week, and what
          I (dis)like about them. These are the tools that stood the test of
          time and best match my principles, plus some new items I'm trying out.
        </p>
        <p>
          Every pick has pros and cons. I tried explaining why I picked
          something over something else and how I handle/accept the downsides.
          Some items link to the post where I wrote about the switch.
        </p>
      </div>

      <nav class="uses-index mt-10" aria-labelledby="uses-index-h">
        <p id="uses-index-h" class="uses-index-h">On this page</p>
        <ul>
          <li><a href="#principles">How I pick tools</a></li>
          {groups.map((group) => <li>
            <a href={`#${group.id}`}>{group.name}</a>
          </li>)}
          {dropped.length > 0 && <li><a href="#dropped">What I dropped</a></li>}
        </ul>
      </nav>

      <section
        id="principles"
        class="uses-section mt-14"
        aria-labelledby="uses-principles"
      >
        <h2 id="uses-principles" class="uses-h">How I pick tools</h2>
        <ol class="principles">
          {principles.map((p) => <li>
            <p class="principle-title">{p.title}</p>
            <p class="principle-text">
              {linkify(p.text).map(({ part, href }) =>
                href ? <a href={href}>{part}</a> : part,
              )}
            </p>
          </li>)}
        </ol>
      </section>

      {groups.map((group) => <section
        id={group.id}
        class="uses-section mt-14"
        aria-labelledby={`${group.id}-h`}
      >
        <h2 id={`${group.id}-h`} class="uses-h">{group.name}</h2>
        <ul class="uses-list">
          {group.items.map((item) => {
            const s = story(item.storyUrl);
            const meta = [
              item.startedAt ? `Since ${partialDate(item.startedAt)}` : null,
              item.replaces?.length
                ? `Replaced ${item.replaces.map((r) => r.name).join(" and ")}`
                : null,
            ].filter(Boolean);
            const img = photo(item);
            return <li
              id={itemId(item)}
              class:list={["uses-item", img && "has-photo"]}
            >
              {img && (
                <Image
                  src={img}
                  alt=""
                  widths={[320, 480, 640]}
                  sizes="(min-width: 640px) 12rem, 100vw"
                  class="item-photo"
                />
              )}
              <div class="item-body">
                <p class="item-name">
                  {item.icon && !img && (
                    <Icon
                      name={item.icon}
                      class="item-icon"
                      aria-hidden="true"
                    />
                  )}
                  <span>{item.name}</span>
                  {item.status === "trying" && <span class="trying"
                    >Evaluating</span
                  >}
                </p>
                {item.reason && <p class="item-reason">
                  {linkify(item.reason).map(({ part, href }) =>
                    href ? <a href={href}>{part}</a> : part,
                  )}
                </p>}
                {item.downside && <p class="item-downside">
                  <span class="font-semibold">Downside:</span>{" "}
                  {linkify(item.downside).map(({ part, href }) =>
                    href ? <a href={href}>{part}</a> : part,
                  )}
                </p>}
                {(item.url || meta.length > 0 || s) && <p class="item-meta">
                  {item.url && <a href={item.url}>{host(item.url)}</a>}
                  {meta.map((m, i) => (
                    <>
                      {(item.url || i > 0) && " · "}
                      {m}
                    </>
                  ))}
                  {s && (
                    <>
                      {(item.url || meta.length > 0) && " · "}
                      Story: <a href={s.href}>{s.title}</a>
                    </>
                  )}
                </p>}
              </div>
            </li>;
          })}
        </ul>
      </section>)}

      <section
        id="dropped"
        class="uses-section mt-14"
        aria-labelledby="uses-dropped"
      >
        <h2 id="uses-dropped" class="uses-h">What I dropped</h2>
        <p class="text-base-700 dark:text-base-300 mb-6 leading-relaxed">
          Stuff I stopped using, and what replaced it.
        </p>
        <ul class="uses-list">
          {dropped.map(({ item, by }) => <li class="uses-item">
            <p class="item-name">
              <span>{item.name}</span>
              {item.endedAt && <span class="item-when">
                until{" "}
                <time datetime={item.endedAt}>{partialDate(item.endedAt)}</time>
              </span>}
            </p>
            {by.length > 0 && <p class="item-meta">
              Replaced by{" "}
              {by.map((b, i) => (
                <>
                  {i > 0 && (i === by.length - 1 ? " and " : ", ")}
                  <a href={`#${itemId(b)}`}>{b.name}</a>
                </>
              ))}
            </p>}
            {item.reason && <p class="item-reason">
              {linkify(item.reason).map(({ part, href }) =>
                href ? <a href={href}>{part}</a> : part,
              )}
            </p>}
          </li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../styles/tailwind.css";

  /* Keep deep-linked headings and items clear of the fixed nav. */
  .uses-section,
  .uses-item {
    scroll-margin-top: 6rem;
  }
  .uses-h {
    @apply text-base-950 dark:text-base-50 font-display mb-5 text-[1.4rem] font-black tracking-[-0.02em];
  }
  .uses-index-h {
    @apply text-base-600 dark:text-base-400 mb-2 text-xs font-bold tracking-[0.08em] uppercase;
  }
  .uses-index ul {
    @apply flex flex-wrap gap-x-4 gap-y-1.5;
  }
  .uses-index a {
    @apply text-base-700 dark:text-base-300 hover:text-primary-700 dark:hover:text-primary-300 decoration-base-300 dark:decoration-base-700 underline underline-offset-4;
  }
  .principles {
    @apply grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2;
  }
  .principle-title {
    @apply text-base-950 dark:text-base-50 font-display font-bold;
  }
  .principle-text {
    @apply text-base-700 dark:text-base-300 mt-1 leading-relaxed;
  }
  .uses-list {
    @apply border-base-200 dark:border-base-800 divide-base-200 dark:divide-base-800 divide-y border-y;
  }
  .uses-item {
    @apply py-4;
  }
  /* Photo on the right from sm up, above the text on small screens. */
  .has-photo {
    @apply flex flex-col gap-4 sm:flex-row-reverse sm:items-start;
  }
  .has-photo .item-body {
    @apply min-w-0 flex-1;
  }
  .item-photo {
    @apply aspect-[3/2] w-full rounded-lg object-cover sm:w-48 sm:shrink-0;
  }
  .item-name {
    @apply text-base-950 dark:text-base-50 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-bold;
  }
  /* Brand or generic icon, in the text colour so it stays quiet. */
  .item-icon {
    @apply text-base-500 dark:text-base-400 -mr-1 size-[1.1em] shrink-0 self-center;
  }
  .item-reason {
    @apply text-base-700 dark:text-base-300 mt-1 leading-relaxed;
  }
  .item-downside {
    @apply text-base-600 dark:text-base-400 mt-1 leading-relaxed;
  }
  .item-meta {
    @apply text-base-600 dark:text-base-400 mt-1 text-[0.95rem];
  }
  .item-when {
    @apply text-base-600 dark:text-base-400 text-[0.95rem] font-normal;
  }
  .trying {
    @apply text-gold-ink dark:text-gold border-gold-light dark:border-gold rounded-md border px-2 py-0.5 text-xs font-bold tracking-[0.06em] uppercase;
  }
</style>
