---
// /uses: the hardware, software and services Guido uses, why, and what he
// dropped along the way. Static; the data lives in src/data/uses.ts.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  categoryOrder,
  currentItems,
  displayName,
  droppedItems,
  featured,
  lastReviewed,
  principles,
  replacedBy,
  type UsesItem,
} from "@data/uses";

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

/** "2026-10" -> "October 2026", "2026" -> "2026". */
const partialDate = (value: string) => {
  const [year, month] = value.split("-");
  return month ? `${MONTHS[Number(month) - 1]} ${year}` : year;
};

/** "2026-11-01" -> "1 November 2026". */
const fullDate = (value: string) => {
  const [year, month, day] = value.split("-");
  return `${Number(day)} ${MONTHS[Number(month) - 1]} ${year}`;
};

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const itemId = (item: UsesItem) => `use-${slugify(displayName(item))}`;

// Bare domains in the texts ("atproto.nl") become links. The split keeps the
// matches at odd indexes. This site's own domain stays plain text.
const DOMAIN =
  /\b((?:[a-z0-9-]+\.)+(?:nl|eu|io|co|com|org|net|app|dev|cafe|do))\b/i;
const SELF = "gui.do";
// The item's link shows as its domain under the text, not on the name.
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const linkDomains = (text: string) =>
  text.split(new RegExp(DOMAIN.source, "gi")).map((part, i) => ({
    part,
    href: i % 2 && part !== SELF ? `https://${part}` : undefined,
  }));
// Markdown-style links ("[Fairbuds XL](https://...)") keep their label; the
// text around them still gets bare-domain linking.
const MD_LINK = /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g;
const linkify = (text: string) => {
  const out: { part: string; href?: string }[] = [];
  let last = 0;
  for (const m of text.matchAll(MD_LINK)) {
    out.push(...linkDomains(text.slice(last, m.index)));
    out.push({ part: m[1], href: m[2] });
    last = m.index! + m[0].length;
  }
  out.push(...linkDomains(text.slice(last)));
  return out;
};

// Item photos live in src/assets/images/uses/; the data holds the file name.
// A name without a file fails the build instead of rendering a broken image.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/uses/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const photo = (item: UsesItem) => {
  if (!item.photo) return undefined;
  const file = photoFiles[`../assets/images/uses/${item.photo}`];
  if (!file) throw new Error(`uses: no photo file "${item.photo}"`);
  return file.default;
};

// Story links point at posts on this site; show the post title as link text
// and link relatively so previews stay on their own host.
const posts = await getCollection("post");
const postTitles = new Map(posts.map((p) => [p.id, p.data.title]));
const story = (url: string | undefined) => {
  if (!url) return undefined;
  const match = url.match(/\/post\/([^/]+)\/?$/);
  if (!match) return { href: url, title: "the story behind it" };
  const id = match[1];
  return { href: `/post/${id}/`, title: postTitles.get(id) ?? id };
};

const groups = categoryOrder
  .map((name) => ({
    name,
    id: slugify(name),
    items: currentItems.filter((i) => i.category === name),
  }))
  .filter((g) => g.items.length > 0)
  // Groups without photos render as a compact card grid.
  .map((g) => ({ ...g, cards: !g.items.some((i) => i.photo) }));

// Photo tiles at the top. A name that isn't a current item with a photo
// fails the build instead of leaving a gap.
const tiles = featured.map((name) => {
  const item = currentItems.find((i) => i.name === name);
  const img = item && photo(item);
  if (!item || !img) throw new Error(`uses: featured "${name}" needs a photo`);
  return { item, img };
});

// "Replaced YouTube Music, which in itself had replaced Spotify": follow one
// step back when the replaced thing is a dropped item with its own replaces.
// A dropped item with usedAs shows as "Mac mini as daily workstation".
const replacedName = (r: { name: string }) => {
  const prev = droppedItems.find(
    (d) => d.name.toLowerCase() === r.name.toLowerCase(),
  );
  const name = prev ? displayName(prev) : r.name;
  return prev?.replaces?.length
    ? `${name}, which in itself had replaced ${prev.replaces.map((x) => x.name).join(" and ")}`
    : name;
};

const dropped = droppedItems.map((item) => ({
  item,
  by: replacedBy(item),
}));

// "Alternatives to": every replaced name, A-Z, with the current items that
// replaced it. A dropped item's own replaces count too (Spotify -> YouTube
// Music -> Plexamp lists Spotify -> Plexamp).
const alternativesMap = new Map<string, { name: string; by: UsesItem[] }>();
const addAlternative = (name: string, item: UsesItem) => {
  const key = name.toLowerCase();
  const entry = alternativesMap.get(key) ?? { name, by: [] };
  if (!entry.by.includes(item)) entry.by.push(item);
  alternativesMap.set(key, entry);
};
for (const item of currentItems) {
  for (const r of item.replaces ?? []) {
    addAlternative(r.name, item);
    const prev = droppedItems.find(
      (d) => d.name.toLowerCase() === r.name.toLowerCase(),
    );
    for (const older of prev?.replaces ?? []) addAlternative(older.name, item);
  }
}
const alternatives = [...alternativesMap.values()].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" }),
);

const index = [
  { id: "principles", name: "How I pick tools" },
  ...groups.map((g) => ({ id: g.id, name: g.name })),
  ...(alternatives.length > 0
    ? [{ id: "alternatives", name: "Alternatives to…" }]
    : []),
  ...(dropped.length > 0 ? [{ id: "dropped", name: "What I dropped" }] : []),
];
---

<BaseLayout
  title="Uses"
  description="The hardware, software and services Guido X Jansen uses, why he picked them, what they cost him, and what he dropped along the way."
>
  <section class="mt-24 w-full px-4">
    <div class="uses-layout mx-auto max-w-3xl">
      <div class="uses-head">
        <header class="mb-8">
          <p
            class="text-gold-light dark:text-gold font-hand -rotate-2 text-[1.5rem] leading-none"
          >
            what I actually use
          </p>
          <h1 class="h1 mt-2">Uses</h1>
          <p class="text-base-500 dark:text-base-400 mt-2 text-[.85rem]">
            Last reviewed
            <time datetime={lastReviewed}>{fullDate(lastReviewed)}</time>
          </p>
        </header>

        {tiles.length > 0 && <ul class="bento" aria-label="Highlights">
          {tiles.map(({ item, img }, i) => <li
            class:list={["bento-tile", i === 0 && "bento-big"]}
          >
            <a href={`#${itemId(item)}`} class="no-random-underline">
              <Image
                src={img}
                alt=""
                widths={i === 0 ? [480, 640, 960] : [320, 480]}
                sizes={
                  i === 0
                    ? "(min-width: 48rem) 24rem, 100vw"
                    : "(min-width: 48rem) 12rem, 50vw"
                }
                class="bento-img"
              />
              <span class="bento-name">{displayName(item)}</span>
            </a>
          </li>)}
        </ul>}

        <div
          class="text-base-700 dark:text-base-300 mt-8 max-w-2xl space-y-4 text-lg leading-relaxed"
        >
          <p>
            This is the hardware, software and services I use every week, and
            what I (dis)like about them. These are the tools that stood the test
            of time and best match my principles, plus some new items I'm trying
            out.
          </p>
          <p>
            Every pick has pros and cons. I tried explaining why I picked
            something over something else and how I handle/accept the downsides.
            Some items link to the post where I wrote about the switch.
          </p>
        </div>
      </div>

      <nav class="uses-index" aria-labelledby="uses-index-h">
        <p id="uses-index-h" class="uses-index-h">On this page</p>
        <ul>
          {index.map((entry) => <li>
            <a href={`#${entry.id}`}>{entry.name}</a>
          </li>)}
        </ul>
      </nav>

      <div class="uses-main">
        <section
          id="principles"
          class="uses-section mt-10"
          aria-labelledby="uses-principles"
        >
          <h2 id="uses-principles" class="uses-h">How I pick tools</h2>
          <ol class="principles">
            {principles.map((p) => <li>
              <details class="principle">
                <summary class="principle-title">{p.title}</summary>
                <p class="principle-text">
                  {linkify(p.text).map(({ part, href }) =>
                    href ? <a href={href}>{part}</a> : part,
                  )}
                </p>
              </details>
            </li>)}
          </ol>
        </section>

        {groups.map((group) => <section
          id={group.id}
          class="uses-section mt-14"
          aria-labelledby={`${group.id}-h`}
        >
          <h2 id={`${group.id}-h`} class="uses-h">{group.name}</h2>
          <ul class:list={[group.cards ? "uses-cards" : "uses-list"]}>
            {group.items.map((item) => {
              const s = story(item.storyUrl);
              const meta = [
                item.startedAt ? `Since ${partialDate(item.startedAt)}` : null,
                item.replaces?.length
                  ? `Replaced ${item.replaces.map(replacedName).join(" and ")}`
                  : null,
              ].filter(Boolean);
              const img = photo(item);
              return <li
                id={itemId(item)}
                class:list={[
                  "uses-item",
                  img && "has-photo",
                  group.cards && "uses-card",
                ]}
              >
                {img && (
                  <Image
                    src={img}
                    alt=""
                    widths={[320, 480, 640]}
                    sizes="(min-width: 640px) 12rem, 100vw"
                    class="item-photo"
                  />
                )}
                <div class="item-body">
                  <p class="item-name">
                    {item.icon && !img && (
                      <Icon
                        name={item.icon}
                        class="item-icon"
                        aria-hidden="true"
                      />
                    )}
                    <span class="item-label">{displayName(item)}</span>
                    {item.status === "trying" && <span class="trying"
                      >Evaluating</span
                    >}
                  </p>
                  {item.reason && <p class="item-reason">
                    {linkify(item.reason).map(({ part, href }) =>
                      href ? <a href={href}>{part}</a> : part,
                    )}
                  </p>}
                  {item.downside && <p class="item-downside">
                    <span class="font-semibold">Downside:</span>{" "}
                    {linkify(item.downside).map(({ part, href }) =>
                      href ? <a href={href}>{part}</a> : part,
                    )}
                  </p>}
                  {(item.url || meta.length > 0 || s) && <p class="item-meta">
                    {item.url && <a href={item.url}>{host(item.url)}</a>}
                    {meta.map((m, i) => (
                      <>
                        {(item.url || i > 0) && " · "}
                        {m}
                      </>
                    ))}
                    {s && (
                      <>
                        {(item.url || meta.length > 0) && " · "}
                        <a href={s.href}
                          >Story<span class="sr-only">: {s.title}</span></a
                        >
                      </>
                    )}
                  </p>}
                </div>
              </li>;
            })}
          </ul>
        </section>)}

        {alternatives.length > 0 && <section
          id="alternatives"
          class="uses-section mt-14"
          aria-labelledby="uses-alternatives"
        >
          <h2 id="uses-alternatives" class="uses-h">Alternatives to…</h2>
          <ul class="alternatives">
            {alternatives.map(({ name, by }) => <li>
              <span class="alt-old">{name}</span>
              <span aria-hidden="true" class="alt-arrow">→</span>
              <span class="sr-only">: replaced by</span>
              <span>
                {by.map((b, i) => (
                  <>
                    {i > 0 && (i === by.length - 1 ? " and " : ", ")}
                    <a href={`#${itemId(b)}`}>{displayName(b)}</a>
                  </>
                ))}
              </span>
            </li>)}
          </ul>
        </section>}

        <section
          id="dropped"
          class="uses-section mt-14"
          aria-labelledby="uses-dropped"
        >
          <h2 id="uses-dropped" class="uses-h">What I dropped</h2>
          <p class="text-base-700 dark:text-base-300 mb-6 leading-relaxed">
            Stuff I stopped using, and what replaced it.
          </p>
          <ul class="uses-list">
            {dropped.map(({ item, by }) => <li class="uses-item">
              <p class="item-name">
                <span>{displayName(item)}</span>
                {item.endedAt && <span class="item-when">
                  until{" "}
                  <time datetime={item.endedAt}
                    >{partialDate(item.endedAt)}</time
                  >
                </span>}
              </p>
              {by.length > 0 && <p class="item-meta">
                Replaced by{" "}
                {by.map((b, i) => (
                  <>
                    {i > 0 && (i === by.length - 1 ? " and " : ", ")}
                    <a href={`#${itemId(b)}`}>{displayName(b)}</a>
                  </>
                ))}
              </p>}
              {item.reason && <p class="item-reason">
                {linkify(item.reason).map(({ part, href }) =>
                  href ? <a href={href}>{part}</a> : part,
                )}
              </p>}
            </li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Marks the index link of the section in view, and keeps it visible in
  // the horizontal strip on small screens. Without JS the index still works.
  const nav = document.querySelector<HTMLElement>(".uses-index");
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>("a") ?? [])];
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((s): s is HTMLElement => s !== null);
  let current: HTMLAnchorElement | undefined;
  let queued = false;

  const update = () => {
    queued = false;
    const line = window.innerHeight * 0.3;
    let active: HTMLElement | undefined;
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= line) active = s;
    }
    const link = active
      ? links.find((a) => a.hash === `#${active.id}`)
      : undefined;
    if (link === current) return;
    current?.removeAttribute("aria-current");
    current = link;
    if (!link || !nav) return;
    link.setAttribute("aria-current", "location");
    const strip = nav.querySelector("ul");
    if (strip && strip.scrollWidth > strip.clientWidth) {
      strip.scrollTo({
        left: link.offsetLeft - strip.clientWidth / 2 + link.offsetWidth / 2,
        behavior: "smooth",
      });
    }
  };

  const queue = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };

  if (nav && sections.length > 0) {
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    update();
  }
</script>

<style>
  @reference "../styles/tailwind.css";

  /* Keep deep-linked headings and items clear of the fixed nav and, below
     xl, the sticky index strip under it. */
  .uses-section,
  .uses-item {
    scroll-margin-top: 7rem;
  }
  .uses-h {
    @apply text-base-950 dark:text-base-50 font-display mb-5 text-[1.4rem] font-black tracking-[-0.02em];
  }

  /* Index: a sticky strip of links under the site nav on small screens, a
     sticky rail left of the content from xl up. */
  .uses-index {
    @apply bg-base-50/95 dark:bg-base-950/95 border-base-200 dark:border-base-800 sticky top-16 z-20 mt-6 flex flex-col rounded-lg border px-3 backdrop-blur;
  }
  .uses-index-h {
    @apply sr-only;
  }
  .uses-index ul {
    @apply m-0 flex gap-x-5 overflow-x-auto py-2 whitespace-nowrap;
    scrollbar-width: none;
    /* Fade the right edge so the strip reads as scrollable. */
    mask-image: linear-gradient(to right, #000 85%, transparent);
  }
  .uses-index a {
    @apply text-base-700 dark:text-base-300 hover:text-primary-700 dark:hover:text-primary-300 text-[0.95rem] underline decoration-transparent underline-offset-4;
  }
  .uses-index a[aria-current] {
    @apply text-base-950 dark:text-base-50 decoration-gold-light dark:decoration-gold decoration-2;
  }
  @media (min-width: 80rem) {
    .uses-layout {
      @apply grid max-w-[64rem] grid-cols-[13rem_minmax(0,48rem)] gap-x-12;
      grid-template-areas: "rail head" "rail main";
    }
    .uses-head {
      grid-area: head;
    }
    .uses-main {
      grid-area: main;
    }
    .uses-section,
    .uses-item {
      scroll-margin-top: 6rem;
    }
    .uses-index {
      @apply top-24 mt-0 block self-start rounded-none border-0 bg-transparent px-0 backdrop-blur-none dark:bg-transparent;
      grid-area: rail;
    }
    .uses-index-h {
      @apply text-base-600 dark:text-base-400 not-sr-only mb-2 block text-xs font-bold tracking-[0.08em] uppercase;
    }
    .uses-index ul {
      @apply flex-col gap-y-1.5 overflow-visible py-0 whitespace-normal;
      mask-image: none;
    }
    .uses-index a[aria-current] {
      @apply decoration-transparent;
    }
    .uses-index li:has(a[aria-current]) {
      @apply border-gold-light dark:border-gold;
    }
    .uses-index li {
      @apply border-l-2 border-transparent pl-3;
    }
  }

  /* Principles collapse to their titles; the text opens on demand. */
  .principles {
    @apply grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2;
  }
  .principle-title {
    @apply text-base-950 dark:text-base-50 font-display hover:text-primary-700 dark:hover:text-primary-300 cursor-pointer py-1 font-bold;
  }
  .principle-title::marker {
    @apply text-base-400 dark:text-base-600;
  }
  .principle-text {
    @apply text-base-700 dark:text-base-300 mt-1 mb-3 leading-relaxed;
  }

  .alternatives {
    @apply grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2;
  }
  .alternatives li {
    @apply text-base-700 dark:text-base-300 leading-snug;
  }
  .alt-old {
    @apply text-base-950 dark:text-base-50 font-semibold;
  }
  .alt-arrow {
    @apply text-base-400 dark:text-base-600 mx-1;
  }
  .uses-list {
    @apply border-base-200 dark:border-base-800 divide-base-200 dark:divide-base-800 divide-y border-y;
  }
  .uses-item {
    @apply py-4;
  }

  /* Photo tiles: one big, four small. Two columns on small screens, four
     from md, where the big tile takes two by two. */
  .bento {
    @apply m-0 grid list-none auto-cols-[42%] grid-flow-col gap-3 overflow-x-auto p-0 md:auto-cols-auto md:grid-flow-row md:grid-cols-4 md:overflow-visible;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .bento-tile {
    scroll-snap-align: start;
  }
  .bento-big {
    @apply md:col-span-2 md:row-span-2;
  }
  .bento-tile a {
    @apply border-base-200 dark:border-base-800 bg-base-50 dark:bg-base-900 hover:border-primary-400 dark:hover:border-primary-500 flex h-full flex-col overflow-hidden rounded-lg border no-underline transition-colors;
  }
  .bento-img {
    @apply aspect-[3/2] w-full object-cover;
  }
  .bento-big .bento-img {
    @apply flex-1;
    @apply md:aspect-auto md:h-0 md:min-h-0;
  }
  .bento-name {
    @apply text-base-950 dark:text-base-50 px-3 py-2 text-sm leading-snug font-bold;
  }
  .bento-big .bento-name {
    @apply md:text-base;
  }

  /* Groups without photos: compact cards, two columns from sm. */
  /* Below sm they read as the plain list. */
  .uses-cards {
    @apply border-base-200 dark:border-base-800 m-0 grid list-none grid-cols-1 border-t p-0 sm:grid-cols-2 sm:gap-3 sm:border-t-0;
  }
  .uses-card {
    @apply sm:border-base-200 sm:dark:border-base-800 sm:bg-base-50/70 sm:dark:bg-base-900/50 border-base-200 dark:border-base-800 border-b sm:rounded-lg sm:border sm:p-4;
  }
  .uses-card .item-reason,
  .uses-card .item-downside {
    @apply text-[0.95rem] leading-relaxed;
  }
  .uses-card .item-meta {
    @apply text-[0.875rem];
  }
  /* Photo on the right from sm up, above the text on small screens. */
  .has-photo {
    @apply flex flex-col gap-4 sm:flex-row-reverse sm:items-start;
  }
  .has-photo .item-body {
    @apply min-w-0 flex-1;
  }
  .item-photo {
    @apply aspect-[3/2] w-full rounded-lg object-cover sm:w-48 sm:shrink-0;
  }
  .item-name {
    @apply text-base-950 dark:text-base-50 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-bold;
  }
  .item-label {
    @apply min-w-0 flex-[1_1_0];
  }
  .item-name:has(.trying) .item-label {
    @apply flex-[0_1_auto];
  }
  /* Brand or generic icon, in the text colour so it stays quiet. */
  .item-icon {
    @apply text-base-500 dark:text-base-400 mt-[0.2em] -mr-1 size-[1.1em] shrink-0 self-start;
  }
  .item-reason {
    @apply text-base-700 dark:text-base-300 mt-1 leading-relaxed;
  }
  .item-downside {
    @apply text-base-600 dark:text-base-400 mt-1 leading-relaxed;
  }
  .item-meta {
    @apply text-base-600 dark:text-base-400 mt-1 text-[0.95rem];
  }
  .item-when {
    @apply text-base-600 dark:text-base-400 text-[0.95rem] font-normal;
  }
  .trying {
    @apply text-gold-ink dark:text-gold border-gold-light dark:border-gold rounded-md border px-2 py-0.5 text-xs font-bold tracking-[0.06em] uppercase;
  }
</style>
