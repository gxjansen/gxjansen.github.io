---
// layout
import PageIndexNav from "@components/PageIndex/PageIndexNav.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

// components
import VideoSection from "@components/Press/VideoSection.astro";
import PodcastSection from "@components/Press/PodcastSection.astro";
import ArticleSection from "@components/Press/ArticleSection.astro";
import ListingsSection from "@components/Press/ListingsSection.astro";
import SifaCTA from "@components/Press/SifaCTA.astro";
import UpcomingEvents from "@components/Events/UpcomingEvents.astro";
import { getAllEvents } from "@utils/eventUtils";

// data
import { pressCoverage } from "../data/press-coverage";
import { filterAvailableContent } from "../utils/content-availability";

// Filter out unavailable content
const availableCoverage = filterAvailableContent(pressCoverage);

// Sort press coverage by date
const sortedCoverage = [...availableCoverage].sort(
  (a, b) =>
    new Date(b.publicationDate).getTime() -
    new Date(a.publicationDate).getTime(),
);

// Separate content by category
const listings = sortedCoverage.filter((item) => item.category === "listing");

// For remaining content (interviews/default), separate by media type
const interviewContent = sortedCoverage.filter(
  (item) => !item.category || item.category === "interview",
);
const videos = interviewContent.filter((item) => item.youtubeLink);
const podcasts = interviewContent.filter((item) => item.spotifyEmbedId);
const articles = interviewContent.filter(
  (item) => !item.youtubeLink && !item.spotifyEmbedId,
);

const index = [
  ...(videos.length > 0 ? [{ id: "videos", name: "Videos" }] : []),
  ...(podcasts.length > 0 ? [{ id: "podcasts", name: "Podcasts" }] : []),
  ...(articles.length > 0 ? [{ id: "articles", name: "Articles" }] : []),
  ...(listings.length > 0 ? [{ id: "listings", name: "Featured in" }] : []),
];

// Log if any content was filtered out
const filteredCount = pressCoverage.length - availableCoverage.length;
if (filteredCount > 0) {
  console.log(`Filtered out ${filteredCount} unavailable content items`);
}

// Debug: Log content counts
console.log("Content counts:", {
  total: sortedCoverage.length,
  videos: videos.length,
  podcasts: podcasts.length,
  articles: articles.length,
  listings: listings.length,
});

// Debug: Log video data
console.log(
  "Video data:",
  videos.map((video) => ({
    title: video.title,
    url: video.youtubeLink,
  })),
);

// Get first few video IDs for preloading
const firstVideoIds = videos
  .slice(0, 2)
  .map((video) => {
    const match = video.youtubeLink?.match(
      /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^&?]+)/,
    );
    return match ? match[1] : "";
  })
  .filter(Boolean);
const events = await getAllEvents();
const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);
const hasUpcoming = events.some((e) => new Date(e.date) >= startOfToday);
---

<BaseLayout
  title="Appearances"
  description="Media appearances, interviews and articles featuring Guido Jansen."
>
  <!-- Resource hints for performance optimization -->
  <Fragment slot="head">
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://open.spotify.com" />

    <!-- DNS prefetch as fallback -->
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://open.spotify.com" />

    <!-- Preload critical thumbnails -->
    {firstVideoIds.map((videoId) => (
      <link
        rel="preload"
        href={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
        as="image"
        fetchpriority="high"
      />
    ))}
  </Fragment>

  <div class="home appearances-page">
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div class="mb-12 max-w-2xl">
        <span class="hand-note">out there</span>
        <h1
          class="font-display mt-2 mb-4 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
        >
          Appearances
        </h1>
        <p class="text-base-600 dark:text-base-400 text-lg leading-relaxed">
          Now and then I'm asked for an interview or opinion piece, or to join a
          panel (online and offline). Below you can find a selection of these.
          Contact me if you're interested in interviewing me or having me on
          your event!
        </p>
        <p class="text-base-500 mt-3 leading-relaxed">
          This page collects podcasts, videos and articles where I showed up as
          a guest. For talks I give at events (past and upcoming), see
          <a
            href="/events/"
            class="text-primary-600 dark:text-primary-400 font-semibold"
            >/events</a
          >. Looking for the awards? They've moved to their own page:
          <a
            href="/awards/"
            class="text-primary-600 dark:text-primary-400 font-semibold"
            >/awards</a
          >
        </p>
      </div>
    </section>

    <PageIndexNav items={index} class="mb-12" />

    <!-- Use view transitions for smooth content switching -->
    <div class="view-transition-group:media-content">
      <VideoSection videos={videos} />
      <PodcastSection podcasts={podcasts} />
      <ArticleSection articles={articles} />
      {listings.length > 0 && <ListingsSection listings={listings} />}
    </div>

    <!-- Next on stage, from /events -->
    {hasUpcoming && <section class="relative z-10 mt-16">
      <UpcomingEvents events={events} maxEvents={2} />
    </section>}

    <SifaCTA />
  </div>
</BaseLayout>

<script>
  // Handle smooth scrolling to sections
  document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll('a[href^="#"]');
    const headerOffset = 80; // Adjust this value based on your header height

    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href");
        if (!targetId) return;
        const targetElement = document.querySelector(targetId);

        if (targetElement) {
          // Get the target's position accounting for header height
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition =
            elementPosition + window.pageYOffset - headerOffset;

          // Smooth scroll to adjusted position
          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });

          // If clicking the podcasts link, trigger preloading
          if (targetId === "#podcasts") {
            // Small delay to ensure scroll starts first
            setTimeout(() => {
              const event = new CustomEvent("preloadPodcasts");
              document.dispatchEvent(event);
            }, 100);
          }
        }
      });
    });
  });

  // Trigger podcast preloading after initial page load
  window.addEventListener("load", () => {
    console.log("Press Page: Initial load complete, preparing podcast preload");

    // Ensure podcasts are preloaded with multiple strategies
    const preloadPodcasts = () => {
      console.log("Press Page: Triggering podcast preload");
      const event = new CustomEvent("preloadPodcasts");
      document.dispatchEvent(event);
    };

    // Multiple preloading strategies
    setTimeout(preloadPodcasts, 500); // Quick initial attempt
    setTimeout(preloadPodcasts, 2000); // Delayed attempt to catch any async content

    // Intersection Observer fallback
    const podcastSection = document.getElementById("podcasts");
    if (podcastSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              console.log("Press Page: Podcasts section entered viewport");
              preloadPodcasts();
              observer.disconnect();
            }
          });
        },
        { threshold: 0.1 },
      );

      observer.observe(podcastSection);
    }
  });
</script>
