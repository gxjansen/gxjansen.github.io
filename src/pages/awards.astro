---
/**
 * /awards: Guido's Sifa honor records (src/lib/honors.ts), loaded from his PDS
 * at build time. Work honors render as award cards; swimming honors are split
 * into Dutch records, senior titles, youth titles and other honors.
 */
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import AwardsSection from "@components/Press/AwardsSection.astro";
import { formatHonorDate, loadHonors, type Honor } from "../lib/honors";

const honors = await loadHonors();
const work = honors.filter((h) => h.area === "work");
const swimming = honors.filter((h) => h.area === "swimming");
const records = swimming.filter((h) => h.kind === "record");
const titles = swimming.filter((h) => h.kind === "championship");
const seniorTitles = titles.filter((h) => !h.youth);
const youthTitles = titles.filter((h) => h.youth);
const otherSwimming = swimming.filter(
  (h) => h.kind !== "record" && h.kind !== "championship",
);

const goldBadge =
  "bg-gold/10 text-gold-ink dark:bg-gold/25 dark:text-gold rounded-full px-2.5 py-0.5 text-xs font-semibold";
const recordBadge =
  "bg-primary-100 text-primary-800 dark:bg-primary-900/50 dark:text-primary-100 rounded-full px-2.5 py-0.5 text-xs font-semibold";
const card =
  "bg-base-50 dark:bg-base-900 border-base-200 dark:border-base-800 rounded-2xl border p-5";
const muted = "text-base-600 dark:text-base-400";
const h3 = "font-display mt-10 mb-3 text-xl font-bold";

const badgeFor = (h: Honor) =>
  h.kind === "record"
    ? { emoji: "🏆", label: "Record", cls: recordBadge }
    : h.kind === "championship"
      ? { emoji: "🥇", label: "Gold", cls: goldBadge }
      : null;
---

<BaseLayout
  title="Awards"
  description="Awards Guido Jansen received for his work, plus a look back at his competitive swimming years."
>
  <div class="home awards-page">
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div class="mb-12 max-w-2xl">
        <span class="hand-note">look, trophies</span>
        <h1
          class="font-display mt-2 mb-4 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
        >
          Awards
        </h1>
        <p class={`${muted} text-lg leading-relaxed`}>
          Sometimes I'm even awarded for what I do! A small collection of
          awards, plus a throwback to my competitive swimming days.
        </p>
      </div>

      {work.length > 0 && <AwardsSection awards={work} heading="For my work" />}

      {swimming.length > 0 && <section
        id="swimming"
        class="mb-16 scroll-mt-24"
        aria-labelledby="swimming-heading"
      >
        <h2 id="swimming-heading" class="h2 mb-4 flex items-center gap-3">
          <Icon
            name="tabler/outline/swimming"
            class="text-primary-600 dark:text-primary-400 size-8 shrink-0"
            aria-hidden="true"
          />
          Swimming
        </h2>
        <p class={`${muted} mb-6`}>
          <a
            href="/about/#athletic-years"
            class="text-primary-600 dark:text-primary-400 font-semibold"
            >The athletic years on /about</a
          >
        </p>

        {[
          { id: "swimming-records", heading: "Dutch records", items: records },
          {
            id: "swimming-senior",
            heading: "Senior titles",
            items: seniorTitles,
          },
          {
            id: "swimming-other",
            heading: "Other honors",
            items: otherSwimming,
          },
        ]
          .filter((g) => g.items.length > 0)
          .map((g, i) => (
            <>
              <h3
                id={g.id}
                class={i === 0 ? "font-display mb-3 text-xl font-bold" : h3}
              >
                {g.heading}
              </h3>
              <ul class="grid gap-4 md:grid-cols-2">
                {g.items.map((h) => {
                  const badge = badgeFor(h);
                  return <li class={card}>
                    <div class="flex flex-wrap items-center gap-2">
                      {badge && <span class={badge.cls}>
                        <span aria-hidden="true">{badge.emoji}</span>{" "}
                        {badge.label}
                      </span>}
                      {h.date && <span class={`${muted} text-sm`}>
                        {formatHonorDate(h.date)}
                      </span>}
                    </div>
                    <p
                      class="text-base-900 dark:text-base-100 mt-2 font-semibold"
                    >
                      {h.title}
                    </p>
                    {h.description && <p class={`${muted} mt-1 text-sm`}>
                      {h.description}
                    </p>}
                    {h.links.length > 0 && <p
                      class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm"
                    >
                      {h.links.map((l) => <a
                        href={l.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary-600 dark:text-primary-400 font-medium"
                      >
                        {l.label} <span aria-hidden="true">→</span>
                        <span class="sr-only"> (opens in new tab)</span>
                      </a>)}
                    </p>}
                  </li>;
                })}
              </ul>
            </>
          ))}

        {youthTitles.length > 0 && (
          <>
            <h3 id="swimming-youth" class={h3}>Youth titles</h3>
            <ul class={`${card} divide-base-200 dark:divide-base-800 divide-y`}>
              {youthTitles.map((h) => <li
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2.5 first:pt-0 last:pb-0"
              >
                <span class={goldBadge}>
                  <span aria-hidden="true">🥇</span> Gold
                </span>
                <span class={`${muted} text-sm tabular-nums`}>
                  {h.date?.slice(0, 4)}
                </span>
                <span class="text-base-900 dark:text-base-100 font-semibold">
                  {h.title}
                </span>
                {h.description && <span class={`${muted} text-sm`}
                  >{h.description}</span
                >}
              </li>)}
            </ul>
          </>
        )}
      </section>}
    </section>
  </div>
</BaseLayout>
