---
/**
 * /awards: awards and nominations for my work (press-coverage.ts entries with
 * category "award" or "nomination") plus competitive swimming results
 * (src/data/swimming.ts).
 */
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import AwardsSection from "@components/Press/AwardsSection.astro";
import { pressCoverage } from "../data/press-coverage";
import {
  swimmingRecords,
  swimmingResults,
  type SwimMedal,
} from "../data/swimming";
import { filterAvailableContent } from "../utils/content-availability";

const awards = filterAvailableContent(pressCoverage)
  .filter((i) => i.category === "award" || i.category === "nomination")
  .sort(
    (a, b) =>
      new Date(b.publicationDate).getTime() -
      new Date(a.publicationDate).getTime(),
  );

const byYear = [...swimmingResults].sort((a, b) => b.year - a.year);
const swims = byYear.filter((r) => !r.ageGroup);
const youthTitles = byYear.filter((r) => r.ageGroup);

const medalEmoji: Record<SwimMedal, string> = {
  gold: "🥇",
  silver: "🥈",
  bronze: "🥉",
};
const medalLabel: Record<SwimMedal, string> = {
  gold: "Gold",
  silver: "Silver",
  bronze: "Bronze",
};
const medalClass: Record<SwimMedal, string> = {
  gold: "bg-gold/10 text-gold-ink dark:bg-gold/25 dark:text-gold",
  silver: "bg-base-200 text-base-800 dark:bg-base-700 dark:text-base-100",
  bronze: "bg-gold-light/20 text-base-900 dark:text-base-100",
};
const ordinal = (n: number) => {
  const teen = n % 100 >= 11 && n % 100 <= 13;
  const suffix = teen ? "th" : ({ 1: "st", 2: "nd", 3: "rd" }[n % 10] ?? "th");
  return `${n}${suffix}`;
};
const recordBadge =
  "bg-primary-100 text-primary-800 dark:bg-primary-900/50 dark:text-primary-100 rounded-full px-2.5 py-0.5 text-xs font-semibold";
const courseLabel = { short: "25m pool", long: "50m pool" };

const card =
  "bg-base-50 dark:bg-base-900 border-base-200 dark:border-base-800 rounded-2xl border p-5";
const muted = "text-base-600 dark:text-base-400";
---

<BaseLayout
  title="Awards"
  description="Awards and nominations Guido Jansen received for his work, plus a look back at his competitive swimming years."
>
  <div class="home awards-page">
    <section
      class="relative z-10 pt-[clamp(6rem,9vw,7rem)] pb-[clamp(2rem,5vw,4rem)]"
    >
      <div class="mb-12 max-w-2xl">
        <span class="hand-note">look, trophies</span>
        <h1
          class="font-display mt-2 mb-4 text-[clamp(2.2rem,5vw,3.2rem)] leading-[1.05] font-black tracking-[-0.03em]"
        >
          Awards
        </h1>
        <p class={`${muted} text-lg leading-relaxed`}>
          Sometimes I'm even awarded for what I do! A small collection of awards
          and nominations, plus a throwback to my competitive swimming days.
        </p>
      </div>

      {awards.length > 0 && (
        <AwardsSection awards={awards} heading="For my work" />
      )}

      {swims.length > 0 && <section
        id="swimming"
        class="mb-16 scroll-mt-24"
        aria-labelledby="swimming-heading"
      >
        <h2 id="swimming-heading" class="h2 mb-4 flex items-center gap-3">
          <Icon
            name="tabler/outline/swimming"
            class="text-primary-600 dark:text-primary-400 size-8 shrink-0"
            aria-hidden="true"
          />
          Swimming
        </h2>
        <p class={`${muted} mb-6`}>
          <a
            href="/about/"
            class="text-primary-600 dark:text-primary-400 font-semibold"
            >The athletic years on /about</a
          >
        </p>
        {swimmingRecords.length > 0 && (
          <>
            <h3
              id="swimming-records"
              class="font-display mb-3 text-xl font-bold"
            >
              Dutch records
            </h3>
            <ul class="grid gap-4 md:grid-cols-3">
              {swimmingRecords.map((rec) => <li class={card}>
                <span class={recordBadge}>
                  <span aria-hidden="true">🏆</span> {rec.title}
                </span>
                <p class="text-base-900 dark:text-base-100 mt-2 font-semibold">
                  {rec.event}
                  <span class={`${muted} font-normal`}> · {rec.time}</span>
                </p>
                {rec.heatsTime && <p class={`${muted} text-sm`}>
                  heats {rec.heatsTime}
                </p>}
                {rec.team && <p class={`${muted} text-sm`}>
                  with {rec.team.join(", ")}
                </p>}
                <p class={`${muted} text-sm`}>
                  {rec.club && `${rec.club} · `}
                  {rec.competition}, {rec.date}
                  {rec.course && ` · ${courseLabel[rec.course]}`}
                </p>
                {(rec.timesImproved || rec.heldUntil) && <p
                  class={`${muted} text-sm`}
                >
                  {rec.timesImproved && `improved ${rec.timesImproved} times`}
                  {rec.timesImproved && rec.heldUntil && " · "}
                  {rec.heldUntil && `held until ${rec.heldUntil}`}
                </p>}
                <a
                  href={rec.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary-600 dark:text-primary-400 mt-2 inline-block text-sm font-medium"
                  aria-label={`Source for ${rec.title}, ${rec.event} (opens in new tab)`}
                >
                  Source <span aria-hidden="true">→</span>
                </a>
              </li>)}
            </ul>
          </>
        )}
        <h3
          id="swimming-senior"
          class="font-display mt-10 mb-3 text-xl font-bold"
        >
          Senior titles and finals
        </h3>
        <ul class="grid gap-4 md:grid-cols-2">
          {swims.map((r) => <li class={card}>
            <div class="flex flex-wrap items-center gap-2">
              {r.medal && <span
                class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${medalClass[r.medal]}`}
              >
                <span aria-hidden="true">{medalEmoji[r.medal]}</span>
                {medalLabel[r.medal]}
              </span>}
              {!r.medal && r.place && <span
                class="bg-base-200 text-base-800 dark:bg-base-700 dark:text-base-100 rounded-full px-2.5 py-0.5 text-xs font-semibold"
              >
                {ordinal(r.place)}
              </span>}
              <span class={`${muted} text-sm`}>{r.year}</span>
              {r.record && <span class={recordBadge}>
                <span aria-hidden="true">🏆</span> {r.record}
              </span>}
            </div>
            <p class="text-base-900 dark:text-base-100 mt-2 font-semibold">
              {r.event}
              {r.time && <span class={`${muted} font-normal`}>
                · {r.time}</span>}
            </p>
            {r.team && <p class={`${muted} text-sm`}>
              with {r.team.join(", ")}
            </p>}
            <p class={`${muted} text-sm`}>
              {r.competition}
              {r.course && ` · ${courseLabel[r.course]}`}
            </p>
            {r.source && <a
              href={r.source}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-600 dark:text-primary-400 mt-2 inline-block text-sm font-medium"
              aria-label={`Source for ${r.year} ${r.event} (opens in new tab)`}
            >
              Source <span aria-hidden="true">→</span>
            </a>}
          </li>)}
        </ul>
        {youthTitles.length > 0 && (
          <>
            <h3
              id="swimming-youth"
              class="font-display mt-10 mb-3 text-xl font-bold"
            >
              Youth titles
            </h3>
            <ul class={`${card} divide-base-200 dark:divide-base-800 divide-y`}>
              {youthTitles.map((r) => <li
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2.5 first:pt-0 last:pb-0"
              >
                {r.medal && <span
                  class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${medalClass[r.medal]}`}
                >
                  <span aria-hidden="true">{medalEmoji[r.medal]}</span>
                  {medalLabel[r.medal]}
                </span>}
                <span class={`${muted} text-sm tabular-nums`}>{r.year}</span>
                <span class="text-base-900 dark:text-base-100 font-semibold">
                  {r.event}
                  {r.time && <span class={`${muted} font-normal`}>
                    · {r.time}</span>}
                </span>
                <span class={`${muted} text-sm`}>
                  {r.competition}, {r.ageGroup}
                  {r.course && ` · ${courseLabel[r.course]}`}
                </span>
              </li>)}
            </ul>
          </>
        )}
      </section>}
    </section>
  </div>
</BaseLayout>
