---
interface Props {
  youtubeId: string;
}

const { youtubeId } = Astro.props;
---

<div class="mb-12">
  <h2 class="h3 mb-4">Video Recording</h2>
  <div class="relative rounded-lg pb-[56.25%]">
    <iframe
      src={`https://www.youtube.com/embed/${youtubeId}`}
      class="bg-base-200 dark:bg-base-800 absolute top-0 left-0 h-full w-full rounded-lg border-none"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
</div>
