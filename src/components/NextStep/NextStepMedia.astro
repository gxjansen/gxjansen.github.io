---
/**
 * Visual preview for a NextStep target: the post's hero image, a headshot,
 * flags of recent event countries, project logos, or an icon tile for pages
 * without an image of their own. Everything resolves at build time.
 */
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import type { TargetKey } from "@data/paths";
import { eventsData } from "@data/events";
import { flagImage, flagName } from "../../lib/flags";
import headshotAbout from "@images/headshot/08.02.2022_Spryker_CEO_2636.jpg";
import headshotSpeaker from "@images/headshot/08.02.2022_Spryker_CEO_0278.jpg";
import headshotContact from "@images/headshot/08.02.2022_Spryker_CEO_2669.jpg";
import crocafe from "@images/crocafe.webp";
import couch from "@images/guido-couch.jpg";
import { domainOverrides } from "@data/domains";
import { slashPages } from "@data/slashes";
import { canon } from "@data/canon";
import { colophon } from "@data/colophon";
import { green } from "@data/green";
import { currentItems } from "@data/uses";

interface Props {
  targetKey: TargetKey;
  href: string;
}

const { targetKey, href } = Astro.props;

const photos: Partial<Record<TargetKey, ImageMetadata>> = {
  about: headshotAbout,
  speaker: headshotSpeaker,
  contact: headshotContact,
  retainer: headshotAbout,
  now: couch,
  crocafe,
};

// Old-commerce topics stay off the paths (see paths design notes).
const legacy = /magento|spryker|dutchento|joomla|sheeptank/i;

// Real content from the target page, shown as chips.
const chips: Partial<Record<TargetKey, string[]>> = {
  domains: Object.entries(domainOverrides)
    .filter(([d, o]) => !o.aliasOf && !legacy.test(d))
    .map(([d]) => d),
  slashes: slashPages
    .filter((p) => p.featured && !p.redirectTo)
    .map((p) => `/${p.slug}`),
  canon: (canon.find((g) => g.name === "Books")?.items ?? []).map(
    (i) => i.name,
  ),
  colophon: colophon.flatMap((g) => g.items.map((i) => i.name)),
  green: green.map((g) => g.name),
  uses: currentItems
    .filter((i) => i.traits?.includes("selfHosted"))
    .map((i) => i.name)
    .filter((n) => n.length <= 22),
};

// Hand-picked: most covers are from the commerce era and some show old
// employers, so the newest list isn't usable as is.
const covers =
  targetKey === "appearances"
    ? [
        "/images/podcasts/open-podcast-community-episode.jpg",
        "/images/podcasts/nohacks-guido-episode.jpg",
        "/images/podcasts/digital-explained-guido-episode.jpg",
        "/images/podcasts/mnot-guido-episode.jpg",
      ]
    : [];

const brandTiles: Partial<Record<TargetKey, { icons: string[]; bg: string }>> =
  {
    follow: {
      icons: ["tabler/brand-bluesky", "tabler/rss"],
      bg: "bg-[#1185fe]",
    },
    verify: {
      icons: [
        "tabler/brand-bluesky",
        "tabler/brand-github",
        "tabler/brand-linkedin",
      ],
      bg: "bg-base-900",
    },
  };

const icons: Partial<Record<TargetKey, string>> = {
  uses: "tabler/outline/tools",
  green: "tabler/outline/world",
  colophon: "tabler/outline/code",
  domains: "tabler/outline/topology-star-3",
  verify: "tabler/outline/shield-check",
  canon: "tabler/outline/book",
  slashes: "tabler/outline/route",
  now: "tabler/outline/bolt",
  appearances: "tabler/outline/microphone",
  retainer: "tabler/outline/briefcase",
  follow: "tabler/brand-bluesky",
};

const postSlug = href.match(/^\/post\/([^/]+)\/$/)?.[1];
const post = postSlug ? await getEntry("post", postSlug) : undefined;
const hero = post?.data.heroImage;

// Most recent distinct event countries, newest first.
const flags =
  targetKey === "events"
    ? [
        ...new Set(
          [...eventsData]
            .sort((a, b) => b.date.localeCompare(a.date))
            .map((e) => e.country)
            .filter(Boolean),
        ),
      ]
        .slice(0, 9)
        .map((code) => ({ code, img: flagImage(code) }))
        .filter((f) => f.img)
    : [];

const projectLogos =
  targetKey === "projects"
    ? ["/icons/sifa-dark.svg", "/icons/barazo-dark.svg", "/icons/n8n-pulse.svg"]
    : [];

const photo = photos[targetKey];
const chipList = (chips[targetKey] ?? []).slice(0, 10);
const brand = brandTiles[targetKey];
const icon = icons[targetKey];
const frame = "aspect-[4/3] w-full overflow-hidden rounded-2xl";
---

{hero ? (
  <Image
    src={hero}
    alt=""
    widths={[320, 480, 640]}
    sizes="(min-width: 640px) 14rem, 100vw"
    class="aspect-[1.9/1] w-full rounded-2xl object-cover shadow-sm"
  />
) : photo ? (
  <Image
    src={photo}
    alt=""
    widths={[320, 480]}
    sizes="(min-width: 640px) 14rem, 100vw"
    class:list={[
      frame,
      "object-cover shadow-sm",
      targetKey === "now" ? "object-[80%_35%]" : "object-top",
    ]}
  />
) : flags.length > 0 ? (
  <ul class="grid grid-cols-3 gap-2" aria-hidden="true">
    {flags.map((f) => <li>
      <Image
        src={f.img!}
        alt={flagName(f.code)}
        width={90}
        height={60}
        class="aspect-[3/2] w-full rounded-md object-cover shadow-[inset_0_0_0_1px] shadow-black/10"
      />
    </li>)}
  </ul>
) : covers.length > 0 ? (
  <div class="grid grid-cols-2 gap-2" aria-hidden="true">
    {covers.map((src) => (
      <img
        src={src}
        alt=""
        width="160"
        height="160"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full rounded-xl object-cover shadow-sm"
      />
    ))}
  </div>
) : chipList.length > 0 ? (
  <div
    class:list={[
      frame,
      "bg-base-900 relative flex flex-wrap content-start gap-1.5 overflow-hidden p-4 dark:bg-black/40",
    ]}
    aria-hidden="true"
  >
    {chipList.map((c, i) => <span
      class:list={[
        "rounded-full px-2.5 py-1 text-[0.72rem] font-semibold whitespace-nowrap",
        i % 3 === 0 ? "bg-gold/90 text-base-900" : "bg-white/10 text-white/85",
        targetKey === "domains" || targetKey === "slashes" ? "font-mono" : "",
      ]}
    >
      {c}
    </span>)}
    <span
      class="from-base-900 pointer-events-none absolute inset-x-0 bottom-0 h-8 rounded-b-2xl bg-gradient-to-t to-transparent dark:from-black/40"
    />
  </div>
) : brand ? (
  <div
    class:list={[frame, brand.bg, "grid place-items-center text-white"]}
    aria-hidden="true"
  >
    <div class="flex items-center gap-4">
      {brand.icons.map((name) => (
        <Icon name={name} class="size-12" />
      ))}
    </div>
  </div>
) : projectLogos.length > 0 ? (
  <div class="grid grid-cols-3 gap-2" aria-hidden="true">
    {projectLogos.map((src) => <div
      class="grid aspect-square place-items-center rounded-xl bg-[#1a1a2e] p-3"
    >
      <img
        src={src}
        alt=""
        width="48"
        height="48"
        class="size-full"
        loading="lazy"
      />
    </div>)}
  </div>
) : icon ? (
  <div
    class:list={[
      frame,
      "bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 grid place-items-center",
    ]}
    aria-hidden="true"
  >
    <Icon name={icon} class="size-16" />
  </div>
) : null}
